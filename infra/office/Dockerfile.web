FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json vite.config.ts index.html ./
COPY src src
COPY public public
ARG VITE_OFFICE_SUPABASE_URL
ARG VITE_OFFICE_SUPABASE_ANON_KEY
ARG VITE_OFFICE_API_URL
ENV VITE_OFFICE_SUPABASE_URL=$VITE_OFFICE_SUPABASE_URL VITE_OFFICE_SUPABASE_ANON_KEY=$VITE_OFFICE_SUPABASE_ANON_KEY VITE_OFFICE_API_URL=$VITE_OFFICE_API_URL
RUN npm run build
FROM nginx:stable-alpine
COPY infra/office/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
