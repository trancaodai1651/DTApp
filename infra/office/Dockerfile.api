FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY apps/office-api apps/office-api
RUN npm run office:build && npm prune --omit=dev --ignore-scripts

FROM node:24-bookworm-slim
ENV NODE_ENV=production OFFICE_HOST=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/apps/office-api/dist ./apps/office-api/dist
COPY --from=build --chown=node:node /app/apps/office-api/package.json ./apps/office-api/package.json
USER node
EXPOSE 8790
CMD ["node","apps/office-api/dist/main.js"]
