# Copy to .env. Never put provider API keys into a VITE_ variable or a desktop build.
HOST=127.0.0.1
PORT=8787
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,https://trancaodai1651.github.io,app://dt
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
XAI_API_KEY=
XAI_MODEL=grok-4.7

# AI Virtual Office (separate API and worker). Public values below are optional
# in Vite; the Office connection screen also accepts URL + publishable key.
OFFICE_SUPABASE_URL=
OFFICE_SUPABASE_ANON_KEY=
# Worker / one-time migration only. NEVER prefix this variable with VITE_.
OFFICE_SUPABASE_SERVICE_KEY=
OFFICE_OPENAI_KEY=
OFFICE_ANTHROPIC_KEY=
OFFICE_PORT=8790
OFFICE_HOST=127.0.0.1
OFFICE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:8080
OFFICE_REDIS_URL=redis://127.0.0.1:6379
# The runner must run in the isolated Linux container, never on the API host.
OFFICE_RUNNER_URL=http://127.0.0.1:8081
OFFICE_RUNNER_TOKEN=
VITE_OFFICE_SUPABASE_URL=
VITE_OFFICE_SUPABASE_ANON_KEY=
# Empty uses same-origin /api/office (Vite/Nginx proxy). Desktop: set HTTPS API.
VITE_OFFICE_API_URL=
