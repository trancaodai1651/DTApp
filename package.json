{
  "name": "dt-poster-studio",
  "version": "0.1.0",
  "private": true,
  "description": "DT App — Không gian sáng tạo và thiết kế poster trên web và desktop",
  "author": "DT Studio",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --x64 --arm64 --publish never",
    "pack:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "test": "node --test tests/*.test.mjs",
    "office:dev": "node --env-file-if-exists=.env apps/office-api/dist/main.js",
    "office:worker": "node --env-file-if-exists=.env apps/office-api/dist/worker.js",
    "office:build": "tsc -p apps/office-api/tsconfig.json",
    "office:typecheck": "tsc -p apps/office-api/tsconfig.json --noEmit",
    "office:test": "node node_modules/typescript/bin/tsc -p apps/office-api/tsconfig.json && vitest run --config vitest.office.config.ts",
    "office:types": "node scripts/generate-office-types.mjs",
    "office:e2e": "playwright test --config playwright.office.config.ts",
    "lint": "eslint src/office apps/office-api/src tests/office --max-warnings 0",
    "office:import": "node --env-file-if-exists=.env scripts/import-office-sqlite.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.2.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "bullmq": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.dtstudio.poster",
    "productName": "DT App",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "licenses/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "artifactName": "DT-Poster-Studio-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "protocols": [
        {
          "name": "DT App Google Sign-in",
          "schemes": [
            "dtapp"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "minimumSystemVersion": "13.0.0"
    }
  }
}
